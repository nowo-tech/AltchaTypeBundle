{
  "name": "nowo-tech/altcha-type-bundle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "vite build && cp src/Resources/assets/css/altcha-type.css src/Resources/public/altcha-type.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "altcha": "^3.2.3"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
